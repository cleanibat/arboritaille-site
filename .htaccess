# arboritaille.ch — Apache/LiteSpeed (Hostinger). URL propres, redirections des anciennes adresses, cache, en-têtes.
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/webp .webp
Options -Indexes
DirectorySlash Off

RewriteEngine On

# Pendant la maintenance, aucune réponse n'est mise en cache (CDN Hostinger compris), aperçu réservé inclus.
RewriteCond %{DOCUMENT_ROOT}/maintenance.flag -f
RewriteRule ^ - [E=MAINT:1]

# 0) MAINTENANCE : actif tant que le fichier maintenance.flag est présent à la racine (le supprimer pour rouvrir le site).
#    Accès réservé : mot de passe saisi sur la page de maintenance -> apercu.php pose le cookie arbo_apercu (30 jours).
#    __APERCU_TOKEN__ est remplacé au déploiement par le secret GitHub APERCU_TOKEN (jamais écrit dans le dépôt).
RewriteCond %{DOCUMENT_ROOT}/maintenance.flag -f
RewriteCond %{HTTP_COOKIE} !(^|;\s*)arbo_apercu=__APERCU_TOKEN__(;|$)
RewriteCond %{REQUEST_URI} !^/(maintenance\.html|apercu\.php|img/|fonts/|robots\.txt)
RewriteRule ^ - [R=503,L]
ErrorDocument 503 /maintenance.html
<IfModule mod_headers.c>
  Header always set Retry-After "86400" "expr=%{REQUEST_STATUS} == 503"
  Header always set Cache-Control "private, no-store" env=MAINT
  Header set Cache-Control "private, no-store" env=MAINT
  Header unset Expires env=MAINT
  Header always set Cache-Control "private, no-store" env=REDIRECT_MAINT
  Header always set Cache-Control "private, no-store" "expr=%{REQUEST_STATUS} == 503"
</IfModule>

# 1) HTTPS et domaine canonique sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://arboritaille.ch/$1 [R=301,L]

# 2) Anciennes adresses du site Hostinger
RewriteRule ^prise-de-rendez-vous/?$ /contact [R=301,L]
RewriteRule ^elagage-quand-et-pourquoi/?$ /conseils/elagage-quand-et-pourquoi [R=301,L]
RewriteRule ^elagage-blog/?$ /conseils [R=301,L]
RewriteRule ^blog/?$ /conseils [R=301,L]
RewriteRule ^conseils/prix-elagage-abattage-arbre/?$ /conseils [R=301,L]

# 2 ter) Pages retirées le 17/11/2026 (cantons de Vaud et Fribourg, guides haies et fruitiers)
