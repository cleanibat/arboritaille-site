# arboritaille.ch — Apache/LiteSpeed (Hostinger). URL propres, redirections des anciennes adresses, cache, en-têtes.
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/webp .webp
Options -Indexes

RewriteEngine On

# 1) HTTPS et domaine canonique sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://arboritaille.ch/$1 [R=301,L]

# 2) Anciennes adresses du site Hostinger
RewriteRule ^prise-de-rendez-vous/?$ /contact [R=301,L]
RewriteRule ^elagage-quand-et-pourquoi/?$ /conseils/elagage-quand-et-pourquoi [R=301,L]
RewriteRule ^elagage-blog/?$ /conseils [R=301,L]
RewriteRule ^blog/?$ /conseils [R=301,L]

# 3) /index.html et /page.html -> URL propre
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4) Barre oblique finale superflue
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5) URL propre -> fichier .html (interne)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)$ $1.html [L]

ErrorDocument 404 /404.html

# 6) Fichiers de travail jamais servis
RedirectMatch 404 ^/(data|tools|content|\.git|\.github)(/|$)
<FilesMatch "\.(py|json|md|log|csv|yml|gitignore)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(sitemap\.xml|robots\.txt)$">
  Require all granted
</FilesMatch>

# 7) Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml font/woff2
</IfModule>

# 8) Cache navigateur (CSS/JS versionnés par ?v=, images et polices longues)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
